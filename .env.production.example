# RoadmapMentor — production example
PORT=5000
APP_URL=https://roadmap.example.com

DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST/DATABASE?sslmode=require
# Empty when using Neon directly. Configure only when routing a standard
# PostgreSQL server through a WebSocket proxy.
DATABASE_WS_PROXY=
DATABASE_WS_PROXY_INSECURE=false

JWT_SECRET=replace-with-a-long-random-production-secret

# Filesystem is suitable for a persistent single-host deployment.
# Multi-instance: use OBJECT_STORAGE_PROVIDER=s3 (see docs/deployment.md).
# Single host: mount OBJECT_STORAGE_LOCAL_DIR on persistent storage.
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_LOCAL_DIR=/app/data/object-storage

OPENAI_API_KEY=
# Resend HTTPS API; verify the MAIL_FROM domain with Resend before enabling email.
RESEND_API_KEY=
MAIL_FROM=Roadmap Mentor <verified@example.com>
