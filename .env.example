# Core application
# Required PostgreSQL connection string.
# Neon works directly. A standard PostgreSQL server can be reached through
# the optional WebSocket proxy settings below.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: self-hosted PostgreSQL transport for @neondatabase/serverless.
# Example in docker-compose.yml: db-proxy:80/v1
DATABASE_WS_PROXY=
DATABASE_WS_PROXY_INSECURE=false

# Required outside local development. Use a long, random value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional runtime settings
PORT=5000
APP_URL=http://localhost:5000

# AI roadmap generation
# Any OpenAI-compatible provider (takes priority). Example for DeepSeek:
#   AI_API_KEY=<key>  AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=
# Model override for every provider (default: gpt-4o)
AI_MODEL=
# OpenAI direct:
OPENAI_API_KEY=
# Replit AI Integration fallback (optional):
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Email notifications (optional; missing values disable successful delivery)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Roadmap Mentor <support@example.com>

# Screenshot/object storage
# Supported providers: filesystem | replit
# "filesystem" is portable across local development and standard Linux/VPS hosts.
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_LOCAL_DIR=.data/object-storage

# Replit adapter only. Example: /bucket-name/private
PRIVATE_OBJECT_DIR=

# Replit-only compatibility values (optional)
REPL_SLUG=
REPL_OWNER=

# Scheduled reminders (optional)
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Paris
SCHEDULER_MIDWEEK_CRON=0 10 * * 3
SCHEDULER_ENDWEEK_CRON=0 10 * * 5
