# Core application
# Required: Neon-compatible PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required outside local development. Use a long, random value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional runtime settings
PORT=5000
APP_URL=http://localhost:5000

# AI roadmap generation
# Preferred outside Replit:
OPENAI_API_KEY=
# Replit AI Integration fallback (optional):
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Email notifications (optional; missing values disable successful delivery)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Roadmap Mentor <support@example.com>

# Screenshot/object storage
# Supported providers: filesystem | replit
# "filesystem" is portable across local development and standard Linux/VPS hosts.
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_LOCAL_DIR=.data/object-storage

# Replit adapter only. Example: /bucket-name/private
PRIVATE_OBJECT_DIR=

# Replit-only compatibility values (optional)
REPL_SLUG=
REPL_OWNER=
