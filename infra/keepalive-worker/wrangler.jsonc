{
  "name": "roadmapmentor-keepalive",
  "main": "worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "vars": {
    "HEALTH_URL": "https://roadmapmentor.onrender.com/health/live",
  },
}
