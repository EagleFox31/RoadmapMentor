{
  "version": 1,
  "fallback": "all",
  "ignorePaths": [
    "README.md",
    "docs/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/workflows/keepalive.yml"
  ],
  "surfaces": {
    "shared-contracts": {
      "paths": [
        "shared/**"
      ],
      "gates": [
        "verify",
        "integration"
      ]
    },
    "database-schema": {
      "paths": [
        "shared/schema.ts",
        "drizzle.config.ts",
        "migrations/**",
        "scripts/migrate-*.ts",
        "scripts/db-*.ts"
      ],
      "gates": [
        "verify",
        "container-build",
        "migrations",
        "integration"
      ]
    },
    "frontend": {
      "paths": [
        "client/**",
        "index.html",
        "vite.config.*",
        "tailwind.config.*",
        "postcss.config.*"
      ],
      "gates": [
        "verify",
        "integration"
      ],
      "dependsOn": [
        "shared-contracts"
      ]
    },
    "backend": {
      "paths": [
        "server/**",
        "scripts/**"
      ],
      "gates": [
        "verify",
        "container-build",
        "integration"
      ],
      "dependsOn": [
        "shared-contracts",
        "database-schema"
      ]
    },
    "container-platform": {
      "paths": [
        "Dockerfile",
        "docker-compose.yml",
        ".dockerignore",
        "render.yaml"
      ],
      "gates": [
        "container-build"
      ]
    },
    "tooling": {
      "paths": [
        "package.json",
        "package-lock.json",
        "tsconfig*.json",
        "components.json",
        ".github/workflows/ci.yml",
        ".github/appfactory-impact.json"
      ],
      "gates": [
        "verify",
        "container-build",
        "migrations",
        "terraform-checks",
        "integration"
      ]
    },
    "terraform-iac": {
      "paths": [
        "infra/terraform/**"
      ],
      "gates": [
        "terraform-checks"
      ]
    },
    "tests-integration": {
      "paths": [
        "test/integration/**",
        "test/e2e/**"
      ],
      "gates": [
        "integration"
      ],
      "dependsOn": [
        "backend"
      ]
    }
  }
}
